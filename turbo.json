{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vite/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "generate:config": {
      "dependsOn": ["@mf-mono/monorepo-tools#build"],
      "outputs": ["apps/website/public/remotes.config.json"]
    }
  }
}
