import { describe, it, expect } from "vite-plus/test";
import { render, screen } from "@testing-library/react";
import App from "./App.js";

describe("App", () => {
  it("should render home page", () => {
    render(<App router="memory" />);

    expect(screen.getByText("{{ shortName }}")).toBeInTheDocument();
    expect(screen.getByText("Welcome to your new micro-frontend!")).toBeInTheDocument();
  });

  it("should use MemoryRouter when router='memory'", () => {
    render(<App router="memory" />);

    // Should render without errors
    expect(screen.getByText("{{ shortName }}")).toBeInTheDocument();
  });

  it("should use BrowserRouter by default", () => {
    render(<App />);

    // Should render without errors
    expect(screen.getByText("{{ shortName }}")).toBeInTheDocument();
  });

  it("should apply basePath prop", () => {
    render(<App basePath="/{{ name }}" router="memory" />);

    expect(screen.getByText("{{ shortName }}")).toBeInTheDocument();
  });
});
