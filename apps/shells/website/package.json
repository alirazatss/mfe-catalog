{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "prebuild": "pnpm run generate:config && pnpm run check:size",
    "generate:config": "tsx ../../../scripts/generate-config.ts",
    "check:size": "tsx ../../../scripts/check-shell-size.ts",
    "preview": "vp preview",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mfe-runtine/auth": "workspace:*",
    "@mfe-runtine/dynamic-loader": "workspace:*",
    "@mfe-runtine/events": "workspace:*",
    "@mfe-runtine/remote-config": "workspace:*",
    "@mfe-runtine/shell-runtime": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
