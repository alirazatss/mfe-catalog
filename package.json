{
  "name": "mf-mono",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && turbo test && turbo build",
    "dev": "turbo dev --filter website",
    "dev:host": "turbo dev --filter website",
    "dev:remote": "turbo dev --filter remote-widget",
    "dev:all": "turbo dev",
    "dev:mfe": "turbo dev --filter 'mfe-*'",
    "build": "turbo build",
    "build:host": "turbo build --filter website",
    "build:remote": "turbo build --filter remote-widget",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@module-federation/vite": "catalog:",
    "turbo": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
