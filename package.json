{
  "name": "mfe-runtine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && turbo test && turbo build",
    "dev": "turbo dev --filter website",
    "dev:host": "turbo dev --filter website",
    "dev:remote": "turbo dev --filter '@mfe-runtine/mfe-widget'",
    "dev:all": "turbo dev",
    "dev:mfe": "turbo dev --filter 'mfe-*'",
    "build": "turbo build",
    "build:host": "turbo build --filter website",
    "build:remote": "turbo build --filter '@mfe-runtine/mfe-widget'",
    "test": "turbo test",
    "test:watch": "turbo test -- --watch",
    "test:coverage": "turbo test -- --coverage",
    "test:ui": "turbo test -- --ui",
    "generate:config": "tsx scripts/generate-config.ts",
    "generate:manifest": "tsx scripts/generate-manifest.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "react-router-dom": "catalog:"
  },
  "devDependencies": {
    "@module-federation/vite": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "happy-dom": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
