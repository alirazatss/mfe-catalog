{
  "name": "@mfe-runtime/dynamic-loader",
  "version": "0.1.0",
  "description": "Runtime dynamic loader for Module Federation micro-frontends",
  "keywords": [
    "dynamic-loader",
    "micro-frontends",
    "module-federation",
    "runtime-config"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.mts",
      "default": "./dist/lifecycle.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/lifecycle.ts --dts --format esm --clean",
    "dev": "tsdown src/index.ts src/lifecycle.ts --dts --format esm --watch",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mfe-runtime/remote-config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^26.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "~6.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
